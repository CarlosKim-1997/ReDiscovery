export async function runFinalSynthesisV2LiveEvaluation(options:FinalSynthesisV2LiveEvaluationOptions={}){
  const checked=await validateFinalSynthesisV2LiveEntry({...(options.env?{env:options.env}:{}),...(options.sealDependencies?{sealDependencies:options.sealDependencies}:{})});
  const makeVerifier=options.makeVerifier??createOpenAIFinalSynthesisV2Verifier;
  const runtime=makeVerifier(checked.apiKey,checked.model);
  const contract=checked.contract;
  const identity:FinalSynthesisV2LiveArtifactIdentity=Object.freeze({schemaVersion:2,gitSha:contract.git_sha,datasetVersion:contract.dataset_version,corpusHash:contract.corpus_sha256,revisionLedgerHash:contract.revision_ledger_sha256,promptVersion:contract.prompt_version,promptHash:contract.prompt_sha256,proofContractVersion:contract.proof_contract_version,productContractVersion:contract.product_contract_version,evaluatorVersion:contract.evaluator_version,contentSlug:contract.content_slug,contentVersion:contract.content_version,contentHash:contract.content_sha256,model:contract.candidate_model,runContractSha256:checked.contractSha256,timestamp:(options.now??(()=>new Date()))().toISOString()});
  const readBytes=options.sealDependencies?.readBytes??(async value=>readFile(value));
  const result=await (options.runEvaluation??runFinalSynthesisV2Evaluation)(runtime.verifier,checked.model,runtime.authority,{liveIdentity:identity,beforeWrite:async()=>{const current=await readBytes(checked.contractFile);if(sha(current)!==checked.contractSha256)throw new Error("FINAL_SYNTHESIS_V2_RUN_CONTRACT_MUTATED")}});
  return{...result,identity};
}
