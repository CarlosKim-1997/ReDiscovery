export interface EvaluatedV2Case{readonly caseId:string;readonly expectedEligible:boolean;readonly predictedEligible:boolean;readonly expectedNodes:Readonly<Record<string,boolean>>;readonly predictedNodes:Readonly<Record<string,boolean>>;readonly expectedComponents:Readonly<Record<string,boolean>>;readonly predictedComponents:Readonly<Record<string,boolean>>;readonly proofFacts:readonly RedactedProofFact[];readonly regressionExact:boolean;readonly schemaApplicationValid:boolean;readonly unavailable:boolean;readonly attempts:readonly FinalSynthesisVerifierV2Attempt[]}
export interface RedactedProofFact{readonly nodeId:string;readonly componentId:string;readonly endorsementStatus:string;readonly referenceStatus:string;readonly componentMatch:string;readonly evidenceUnitIds:readonly string[];readonly antecedentEvidenceUnitIds:readonly string[];readonly satisfied:boolean}
export interface FinalSynthesisV2ProviderExecutionSnapshot{readonly total:number;readonly byCase:Readonly<Record<string,number>>}
export class FinalSynthesisV2ProviderExecutionAuthority implements FinalSynthesisV2TransportExecutionObserver{private currentCaseId:string|undefined;private total=0;private readonly byCase:Record<string,number>={};beginCase(caseId:string){this.currentCaseId=caseId}recordTransportExecution(){if(!this.currentCaseId)throw new Error("FINAL_SYNTHESIS_V2_EXECUTION_CASE_NOT_SET");this.total++;this.byCase[this.currentCaseId]=(this.byCase[this.currentCaseId]??0)+1}snapshot():FinalSynthesisV2ProviderExecutionSnapshot{return{total:this.total,byCase:{...this.byCase}}}}
const metric=(items:readonly EvaluatedV2Case[],e:(x:EvaluatedV2Case)=>boolean,p:(x:EvaluatedV2Case)=>boolean)=>{let tp=0,fp=0,fn=0,tn=0;for(const x of items){if(e(x)&&p(x))tp++;else if(!e(x)&&p(x))fp++;else if(e(x)&&!p(x))fn++;else tn++}return{tp,fp,fn,tn,precision:tp+fp?tp/(tp+fp):1,recall:tp+fn?tp/(tp+fn):1}};
export function buildFinalSynthesisV2EvaluationReport(cases:readonly FinalSynthesisV2Case[],rows:readonly EvaluatedV2Case[],criticalIds:readonly string[],requiredNodes:FinalSynthesisVerifierV2Input["requiredNodes"],execution:FinalSynthesisV2ProviderExecutionSnapshot,componentDescriptions:readonly string[]=[]){const approval=metric(rows,x=>x.expectedEligible,x=>x.predictedEligible);const nodeIds=requiredNodes.map(x=>x.nodeId),componentIds=requiredNodes.flatMap(x=>x.requiredComponents.map(c=>c.componentId));const node=keyedMetrics(rows,nodeIds,x=>x.expectedNodes,x=>x.predictedNodes),component=keyedMetrics(rows,componentIds,x=>x.expectedComponents,x=>x.predictedComponents);const retryCases=rows.filter(x=>x.attempts.length>1).length,attemptRecords=rows.flatMap(x=>x.attempts).length,valid=rows.filter(x=>x.schemaApplicationValid).length,unavailable=rows.filter(x=>x.unavailable).length,regressionMismatchIds=criticalIds.filter(id=>!rows.find(x=>x.caseId===id)?.regressionExact);const redactedCases=rows.map(x=>({caseId:x.caseId,expectedEligible:x.expectedEligible,predictedEligible:x.predictedEligible,expectedNodes:x.expectedNodes,predictedNodes:x.predictedNodes,expectedComponents:x.expectedComponents,predictedComponents:x.predictedComponents,proofFacts:x.proofFacts,regressionExact:x.regressionExact,schemaApplicationValid:x.schemaApplicationValid,unavailable:x.unavailable,attempts:x.attempts}));const report={identity:{datasetVersion:FINAL_SYNTHESIS_V2_DATASET_VERSION,promptVersion:FINAL_SYNTHESIS_V2_PROMPT_VERSION,proofVersion:FINAL_SYNTHESIS_PROOF_V2_CONTRACT_VERSION,evaluatorVersion:FINAL_SYNTHESIS_V2_EVALUATOR_VERSION},availability:{total:cases.length,evaluated:rows.length-unavailable,unavailable},approval,node,component,critical:{exact:criticalIds.length-regressionMismatchIds.length,total:criticalIds.length,mismatchIds:regressionMismatchIds},operational:{independentActualProviderExecutions:execution.total,attemptRecordCount:attemptRecords,actualTransportsByCase:execution.byCase,retryCases,unavailable},cases:redactedCases};const leakage=scanFinalSynthesisV2ReportLeakage(report,cases,componentDescriptions);const validationReasonsComplete=rows.flatMap(x=>x.attempts).filter(isApplicationValidationAttempt).every(x=>!!x.validationReason);const integrity=evaluatorIntegrity(cases,rows,requiredNodes,execution);const gates={caseCount:cases.length===96,falseApprovals:approval.fp===0,approvalPrecision:approval.precision===1,approvalRecall:approval.recall>=.85,nodeMicroPrecision:node.micro.precision>=.95,everyNodePrecision:Object.values(node.perKey).every(x=>x.precision>=.95),componentMicroPrecision:component.micro.precision>=.95,everyComponentPrecision:Object.values(component.perKey).every(x=>x.precision>=.95),critical:regressionMismatchIds.length===0,schemaApplication:valid===96,unrecovered:unavailable===0,leakage:leakage===0,retryRate:retryCases/96<=.05,attemptAccounting:execution.total===attemptRecords,perCaseAttemptAccounting:integrity.perCaseAttemptAccounting,attemptSequence:integrity.attemptSequence,validationReasonsComplete,proofCompleteness:integrity.proofCompleteness,derivedConsistency:integrity.derivedConsistency,terminalDiagnostics:integrity.terminalDiagnostics};return{...report,privacy:{leakage},hardGates:gates,accepted:Object.values(gates).every(Boolean)}}
function isApplicationValidationAttempt(x:FinalSynthesisVerifierV2Attempt){return x.failureCategory==="PROOF_RECORD_INVALID"||x.failureCategory==="NODE_SET_INVALID"||x.failureCategory==="EVIDENCE_UNIT_INVALID"||x.failureCategory==="PROOF_SHAPE_INVALID"}
function evaluatorIntegrity(cases:readonly FinalSynthesisV2Case[],rows:readonly EvaluatedV2Case[],requiredNodes:FinalSynthesisVerifierV2Input["requiredNodes"],execution:FinalSynthesisV2ProviderExecutionSnapshot){const caseById=new Map(cases.map(x=>[x.id,x]));let perCaseAttemptAccounting=true,attemptSequence=true,proofCompleteness=true,derivedConsistency=true,terminalDiagnostics=true;for(const row of rows){if((execution.byCase[row.caseId]??0)!==row.attempts.length)perCaseAttemptAccounting=false;const numbers=row.attempts.map(x=>x.attempt);if(numbers.length<1||numbers.length>2||numbers.some((value,index)=>value!==index+1))attemptSequence=false;if(row.unavailable){const last=row.attempts.at(-1);if(!last||last.resultStatus==="SUCCEEDED"||!last.failureCategory||row.proofFacts.length||Object.keys(row.predictedNodes).length||Object.keys(row.predictedComponents).length)terminalDiagnostics=false;continue}const item=caseById.get(row.caseId);if(!item){proofCompleteness=false;derivedConsistency=false;continue}const nodeIds=row.proofFacts.map(x=>x.nodeId),expectedNodeIds=requiredNodes.map(x=>x.nodeId);if(new Set(nodeIds).size!==expectedNodeIds.length||expectedNodeIds.some(id=>!nodeIds.includes(id))||nodeIds.some(id=>!expectedNodeIds.includes(id)))proofCompleteness=false;const byNode=new Map<string,RedactedProofFact[]>();for(const fact of row.proofFacts)byNode.set(fact.nodeId,[...(byNode.get(fact.nodeId)??[]),fact]);for(const required of requiredNodes){const facts=byNode.get(required.nodeId)??[],ids=facts.map(x=>x.componentId),expected=required.requiredComponents.map(x=>x.componentId);if(new Set(ids).size!==expected.length||expected.some(id=>!ids.includes(id))||ids.some(id=>!expected.includes(id)))proofCompleteness=false}try{const proof={nodes:requiredNodes.map(node=>({nodeId:node.nodeId,components:(byNode.get(node.nodeId)??[]).map(f=>({componentId:f.componentId,endorsementStatus:f.endorsementStatus,referenceStatus:f.referenceStatus,componentMatch:f.componentMatch,evidenceUnitIds:f.evidenceUnitIds,antecedentEvidenceUnitIds:f.antecedentEvidenceUnitIds}))}))};const derived=deriveFinalSynthesisV2Verification(proof,buildFinalSynthesisV2VerifierInput(requiredNodes,item.synthesis));for(const node of derived.nodes){if(row.predictedNodes[node.nodeId]!== (node.support==="VERIFIED"))derivedConsistency=false;for(const component of node.components){const fact=row.proofFacts.find(x=>x.nodeId===node.nodeId&&x.componentId===component.componentId);if(!fact||fact.satisfied!==component.satisfied||row.predictedComponents[component.componentId]!==component.satisfied)derivedConsistency=false}}if(row.predictedEligible!==isFinalSynthesisV2Eligible(derived))derivedConsistency=false}catch{proofCompleteness=false;derivedConsistency=false}}if(Object.keys(execution.byCase).some(id=>!caseById.has(id)))perCaseAttemptAccounting=false;return{perCaseAttemptAccounting,attemptSequence,proofCompleteness,derivedConsistency,terminalDiagnostics}}
function keyedMetrics(rows:readonly EvaluatedV2Case[],keys:readonly string[],expected:(x:EvaluatedV2Case)=>Readonly<Record<string,boolean>>,predicted:(x:EvaluatedV2Case)=>Readonly<Record<string,boolean>>){const perKey=Object.fromEntries(keys.map(key=>[key,metric(rows,x=>!!expected(x)[key],x=>!!predicted(x)[key])]));const totals=Object.values(perKey).reduce((a,m)=>({tp:a.tp+m.tp,fp:a.fp+m.fp,fn:a.fn+m.fn,tn:a.tn+m.tn}),{tp:0,fp:0,fn:0,tn:0});return{perKey,micro:{...totals,precision:totals.tp+totals.fp?totals.tp/(totals.tp+totals.fp):1,recall:totals.tp+totals.fn?totals.tp/(totals.tp+totals.fn):1}}}
export function scanFinalSynthesisV2ReportLeakage(report:unknown,cases:readonly FinalSynthesisV2Case[],descriptions:readonly string[]=[]){const text=JSON.stringify(report);return[FINAL_SYNTHESIS_V2_SYSTEM_PROMPT,...cases.map(x=>x.synthesis),...cases.map(x=>x.rationale),...descriptions].filter(x=>text.includes(x)).length}
export function toEvaluatedV2(item:FinalSynthesisV2Case,derived:DerivedFinalSynthesisV2Verification,proof:{nodes:readonly {nodeId:string;components:readonly UnvalidatedFinalSynthesisV2ComponentProof[]}[]},attempts:readonly FinalSynthesisVerifierV2Attempt[]):EvaluatedV2Case{const expectedNodes=Object.fromEntries(derived.nodes.map(n=>[n.nodeId,n.components.every(c=>item.expected_components[c.componentId])]));const predictedNodes=Object.fromEntries(derived.nodes.map(n=>[n.nodeId,n.support==="VERIFIED"]));const predictedComponents=Object.fromEntries(derived.nodes.flatMap(n=>n.components.map(c=>[c.componentId,c.satisfied])));const proofFacts=proof.nodes.flatMap(n=>n.components.map(c=>({nodeId:n.nodeId,componentId:c.componentId,endorsementStatus:c.endorsementStatus,referenceStatus:c.referenceStatus,componentMatch:c.componentMatch,evidenceUnitIds:c.evidenceUnitIds,antecedentEvidenceUnitIds:c.antecedentEvidenceUnitIds,satisfied:derived.nodes.find(x=>x.nodeId===n.nodeId)!.components.find(x=>x.componentId===c.componentId)!.satisfied})));const regressionExact=(item.expected_proof_facts??[]).every(e=>{const a=proofFacts.find(x=>x.nodeId===e.node_id&&x.componentId===e.component_id);return !!a&&JSON.stringify([a.endorsementStatus,a.referenceStatus,a.componentMatch,a.evidenceUnitIds,a.antecedentEvidenceUnitIds])===JSON.stringify([e.endorsement_status,e.reference_status,e.component_match,e.evidence_unit_ids,e.antecedent_evidence_unit_ids])});return{caseId:item.id,expectedEligible:item.expected_eligible,predictedEligible:isFinalSynthesisV2Eligible(derived),expectedNodes,predictedNodes,expectedComponents:item.expected_components,predictedComponents,proofFacts,regressionExact,schemaApplicationValid:true,unavailable:false,attempts}}
export async function runFinalSynthesisV2Evaluation(verifier:FinalSynthesisVerifierV2Port,model:string,authority:FinalSynthesisV2ProviderExecutionAuthority,artifactOptions:FinalSynthesisV2ArtifactOptions={}){const suite=await loadFinalSynthesisV2DevelopmentSuite();const rows:EvaluatedV2Case[]=[];for(const item of suite.cases){authority.beginCase(item.id);const input=buildFinalSynthesisV2VerifierInput(suite.requiredNodes,item.synthesis);try{const execution=await verifier.extractProof(input);rows.push(toEvaluatedV2(item,deriveFinalSynthesisV2Verification(execution.proof,input),execution.proof,execution.attempts))}catch(error){const attempts=error instanceof FinalSynthesisV2ExecutionError?error.attempts:[];rows.push({caseId:item.id,expectedEligible:item.expected_eligible,predictedEligible:false,expectedNodes:{},predictedNodes:{},expectedComponents:item.expected_components,predictedComponents:{},proofFacts:[],regressionExact:false,schemaApplicationValid:false,unavailable:true,attempts})}}const report=buildFinalSynthesisV2EvaluationReport(suite.cases,rows,suite.manifest.required_regression_case_ids,suite.requiredNodes,authority.snapshot(),suite.requiredNodes.flatMap(n=>n.requiredComponents.map(c=>c.description)));await artifactOptions.beforeWrite?.();const identity=artifactOptions.liveIdentity??{...report.identity,model,corpusHash:suite.corpusHash,promptHash:suite.promptHash,contentHash:suite.contentHash};const dir=path.resolve("artifacts/eval/final-synthesis");await mkdir(dir,{recursive:true});const file=path.join(dir,`final-synthesis-dev-v2-${Date.now()}.json`);await writeFile(file,JSON.stringify({...report,identity},null,2));return{file,report}}
export function createOpenAIFinalSynthesisV2Verifier(apiKey:string,model:string){const authority=new FinalSynthesisV2ProviderExecutionAuthority();return{verifier:new OpenAIFinalSynthesisVerifierV2Adapter(new OpenAIResponsesFinalSynthesisV2Transport(apiKey),model,authority),authority}}

export interface FinalSynthesisV2LiveEvaluationOptions{
  readonly env?:Readonly<Record<string,string|undefined>>;
  readonly sealDependencies?:FinalSynthesisV2RunSealDependencies;
  readonly makeVerifier?:(apiKey:string,model:string)=>{readonly verifier:FinalSynthesisVerifierV2Port;readonly authority:FinalSynthesisV2ProviderExecutionAuthority};
  readonly runEvaluation?:typeof runFinalSynthesisV2Evaluation;
  readonly now?:()=>Date;
