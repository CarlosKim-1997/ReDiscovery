  const env=options.env??process.env;if(env.FINAL_SYNTHESIS_V2_LIVE_RUN!=="1")throw new Error("FINAL_SYNTHESIS_V2_LIVE_OPT_IN_REQUIRED");const contractFile=env.FINAL_SYNTHESIS_V2_RUN_CONTRACT;if(!contractFile)throw new Error("FINAL_SYNTHESIS_V2_RUN_CONTRACT_REQUIRED");const checked=await validateFinalSynthesisV2RunContract({contractFile,...(options.sealDependencies?{sealDependencies:options.sealDependencies}:{})});const model=env.FINAL_SYNTHESIS_V2_MODEL;if(!model||model!==checked.contract.candidate_model)throw new Error("FINAL_SYNTHESIS_V2_RUN_CONTRACT_MISMATCH:candidate_model");const exists=options.sealDependencies?.pathExists??defaultPathExists;for(const file of persistentCredentialFiles)if(await exists(path.join(checked.repoRoot,file)))throw new Error(`FINAL_SYNTHESIS_V2_PERSISTENT_CREDENTIAL_FILE:${file}`);if(!env.OPENAI_API_KEY)throw new Error("OPENAI_API_KEY_REQUIRED");return Object.freeze({...checked,model,apiKey:env.OPENAI_API_KEY});
}

