export interface FinalSynthesisGitResult{readonly status:number;readonly stdout:string}
export interface FinalSynthesisRunSealDependencies{
  readonly repoRoot?:string;
  readonly runGit?:(args:readonly string[],cwd:string)=>FinalSynthesisGitResult;
  readonly resolveRealPath?:(value:string)=>Promise<string>;
}
function defaultRunGit(args:readonly string[],cwd:string):FinalSynthesisGitResult{const result=spawnSync("git",args,{cwd,encoding:"utf8"});return{status:result.status??1,stdout:result.stdout??""}}
async function validateRunContractSeal(contractFile:string,deps:FinalSynthesisRunSealDependencies){
  const repoRoot=await (deps.resolveRealPath??realpath)(deps.repoRoot??path.resolve("."));const resolvePath=deps.resolveRealPath??realpath;const runGit=deps.runGit??defaultRunGit;
  const canonicalRoot=await resolvePath(path.join(repoRoot,"artifacts/eval/final-synthesis/run-contracts"));const contractReal=await resolvePath(path.resolve(contractFile));const relative=path.relative(canonicalRoot,contractReal);
  if(!relative||relative.startsWith(`..${path.sep}`)||relative===".."||path.isAbsolute(relative))throw new Error("FINAL_SYNTHESIS_RUN_CONTRACT_PATH_INVALID");
  const repoRelative=path.relative(repoRoot,contractReal);if(repoRelative.startsWith(`..${path.sep}`)||path.isAbsolute(repoRelative))throw new Error("FINAL_SYNTHESIS_RUN_CONTRACT_PATH_INVALID");
  const status=runGit(["status","--porcelain","--untracked-files=all"],repoRoot);if(status.status!==0||status.stdout.trim())throw new Error("FINAL_SYNTHESIS_WORKTREE_NOT_CLEAN");
  const tracked=runGit(["ls-files","--",repoRelative],repoRoot);if(tracked.status!==0||tracked.stdout.trim())throw new Error("FINAL_SYNTHESIS_RUN_CONTRACT_TRACKED");
  const ignored=runGit(["check-ignore","--quiet","--",repoRelative],repoRoot);if(ignored.status!==0)throw new Error("FINAL_SYNTHESIS_RUN_CONTRACT_NOT_IGNORED");
  const head=runGit(["rev-parse","HEAD"],repoRoot);if(head.status!==0||!head.stdout.trim())throw new Error("FINAL_SYNTHESIS_GIT_IDENTITY_UNAVAILABLE");return{gitSha:head.stdout.trim(),contractReal};
}
export async function validateFinalSynthesisRunContract(env:Readonly<Record<string,string|undefined>>=process.env,deps:FinalSynthesisRunSealDependencies={}){
  const suite=await loadFinalSynthesisDevelopmentSuite();if(env.FINAL_SYNTHESIS_LIVE_RUN!=="1")throw new Error("FINAL_SYNTHESIS_LIVE_OPT_IN_REQUIRED");const contractFile=env.FINAL_SYNTHESIS_RUN_CONTRACT;if(!contractFile)throw new Error("FINAL_SYNTHESIS_RUN_CONTRACT_REQUIRED");
  const sealed=await validateRunContractSeal(contractFile,deps);const contract=runContractSchema.parse(JSON.parse(await readFile(sealed.contractReal,"utf8")));const expected={git_sha:sealed.gitSha,dataset_version:suite.manifest.dataset_version,corpus_sha256:suite.corpusHash,prompt_version:suite.manifest.prompt_version,prompt_sha256:suite.promptHash,proof_contract_version:suite.manifest.proof_contract_version,evaluator_version:suite.manifest.evaluator_version,content_slug:suite.manifest.content_slug,content_version:suite.manifest.content_version,content_sha256:suite.contentHash};for(const [key,value] of Object.entries(expected))if(contract[key as keyof typeof contract]!==value)throw new Error(`FINAL_SYNTHESIS_RUN_CONTRACT_MISMATCH:${key}`);if(!env.FINAL_SYNTHESIS_MODEL||env.FINAL_SYNTHESIS_MODEL!==contract.candidate_model)throw new Error("FINAL_SYNTHESIS_RUN_CONTRACT_MISMATCH:candidate_model");if(!env.OPENAI_API_KEY)throw new Error("OPENAI_API_KEY_REQUIRED");return{suite,contract,apiKey:env.OPENAI_API_KEY}
}

