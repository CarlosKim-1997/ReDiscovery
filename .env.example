# M0 works without credentials or a local environment file.
# Copy to .env.local only when overriding these defaults.
APP_ENV=local
CONFIG_VERSION=m2-v1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# NODE_ENV is managed by Next.js; do not set it here.
# No NEXT_PUBLIC_* variables or vendor credentials are needed in M0.
