# M0 works without credentials or a local environment file.
# Copy to .env.local only when overriding these defaults.
APP_ENV=local
CONFIG_VERSION=m3-v1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
JUDGE_ADAPTER=fake
# Set all three below only on the server. M3 gameplay uses PRIMARY_JUDGE_MODEL only.
# JUDGE_ADAPTER=openai
# OPENAI_API_KEY=
# PRIMARY_JUDGE_MODEL=
# ADJUDICATION_MODEL=
# REVEAL_COMPARISON_MODEL=
# NODE_ENV is managed by Next.js; do not set it here.
# Never create NEXT_PUBLIC_OPENAI_* variables.
